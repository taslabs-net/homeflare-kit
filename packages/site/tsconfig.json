{
  // ⛔ EXTENDS tsconfig.base.json, NOT tsconfig.lib.json — the same documented exception
  //   as @homeflare/alchemy, for the same reason.
  //
  // ⚠️ isolatedDeclarations CANNOT STATE AN EFFECT SCHEMA'S TYPE. `SiteSchema` is a value
  //   whose type is the schema: annotating it explicitly means writing the whole struct a
  //   second time as a type, and the two would drift — the exact failure the flag exists
  //   to prevent. So the .d.ts for schema.ts is INFERRED.
  // ★ WHAT HOLDS THE LINE INSTEAD: every other export here carries an explicit type or
  //   interface (Derived, Pins, Identity, LoadedSite…), `bun run types` checks it all, and
  //   the smoke test typechecks the published .d.ts from a consumer with skipLibCheck off.
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "declaration": true
  },
  "include": ["src", "tests", "scripts"]
}
