{
  // Self-contained on purpose — same compiler baseline as
  // packages/distilled-netbox (see README.md), never the kit's
  // packages/config presets (in particular, NOT isolatedDeclarations).
  // ⚠️ This package is a STUB scaffold today. When src/ is replaced by a
  // regenerate+copy from Cilium's official OpenAPI, generated services/*.ts
  // will rely on the `as any as S.Schema<X>` cast pattern distilled's own
  // compiler emits, and forcing that through a different lib preset is
  // exactly the friction the interim route exists to avoid. Copied unchanged
  // from packages/distilled-netbox — change nothing but this comment.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts"]
}
