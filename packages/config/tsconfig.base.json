{
  // The HomeFlare TypeScript baseline. Every project extends this and overrides only
  // what its runtime genuinely needs.
  //
  //     { "extends": "@homeflare/config/tsconfig.base.json" }
  //
  // ★ WHY THESE SETTINGS AND NOT tsc's DEFAULTS. Each one below turns a class of runtime
  //   bug into a compile error. They are painful to adopt late and nearly free to adopt
  //   at the start, which is the whole argument for a shared baseline.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    // ⛔ Emit is a build tool's job, never the checker's.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    // ⚠️ arr[0] is T | undefined, not T. The single most common source of "cannot read
    //   property of undefined" in production, and the flag that catches it.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // ⚠️ Distinguishes `{ a?: string }` from `{ a: string | undefined }`. Without it,
    //   an optional property can be explicitly set to undefined and typecheck.
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true
  }
}
