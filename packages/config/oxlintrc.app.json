{
  "extends": ["./oxlintrc.json"],
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "**/generated/**",
    "**/*.gen.ts",
    "**/vendor/**",
    "**/*.openapi.yaml",
    "**/*.openapi.yml",
    "**/openapi.json"
  ],
  "rules": {
    "import/no-default-export": "off",
    "jsx-a11y/control-has-associated-label": "off"
  },
  "overrides": [
    {
      "files": ["src/**", "workers/**", "app/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/scripts/**"],
      "rules": {
        "no-console": "off",
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
