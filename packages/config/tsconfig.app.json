{
  // For a Worker or app that IMPORTS packages which publish TypeScript source.
  //
  //     { "extends": "@homeflare/config/tsconfig.app.json" }
  //
  // ★ THE STRICT BASELINE STAYS. tsconfig.base.json and tsconfig.lib.json keep
  //   exactOptionalPropertyTypes, noImplicitOverride and noUncheckedIndexedAccess —
  //   they catch real bugs in code you own.
  //
  // ⛔ skipLibCheck CANNOT HELP HERE. It only skips .d.ts. Measured 2026-09-16:
  //   @cloudflare/ci@0.2.0 ships `"types": "./src/index.ts"`, and Better Auth plugin
  //   types do the same via a `dev-source` condition. Those files typecheck under
  //   THIS project's flags, so the three below fail the consumer, not the library.
  //
  // Override them back on in a project that does not import source-publishing deps.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noUncheckedIndexedAccess": false
  }
}
