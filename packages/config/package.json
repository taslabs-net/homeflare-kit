{
  "name": "@homeflare/config",
  "version": "0.3.0",
  "description": "Shared tsconfig, oxlint and oxfmt configuration for HomeFlare projects.",
  "license": "MIT",
  "author": "Timothy Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taslabs-net/homeflare-kit.git",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.base.json",
    "tsconfig.lib.json",
    "tsconfig.app.json",
    "oxlintrc.json",
    "oxfmtrc.json",
    "bunfig.toml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.lib.json": "./tsconfig.lib.json",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./oxlintrc.json": "./oxlintrc.json",
    "./oxfmtrc.json": "./oxfmtrc.json",
    "./bunfig.toml": "./bunfig.toml",
    "./check": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/check.ts --outdir dist --target bun --format esm --packages external --sourcemap=linked",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "types": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts"
  }
}
