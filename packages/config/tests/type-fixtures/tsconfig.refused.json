{
  // ⛔ A PROJECT OF ITS OWN, extending the real house config rather than a hand-listed set
  //   of tsc flags. The thing under test is "does this call compile under the settings
  //   this package actually ships" — re-typing the flags on a command line would let the
  //   two drift, and `--ignoreConfig` drops `skipLibCheck` and `types` as well, which made
  //   the GOOD fixture fail on unrelated @types/node collisions (measured 2026-09-22).
  "extends": "../../tsconfig.lib.json",
  "compilerOptions": { "types": ["bun"], "noEmit": true },
  "files": ["no-reason.ts", "computed-reason.ts", "job-no-reason.ts"]
}
