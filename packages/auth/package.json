{
  "name": "@homeflare/auth",
  "version": "0.1.3",
  "description": "Better Auth wiring for HomeFlare, with the Cloudflare adapter.",
  "homepage": "https://github.com/taslabs-net/homeflare-kit/tree/main/packages/auth#readme",
  "bugs": "https://github.com/taslabs-net/homeflare-kit/issues",
  "license": "MIT",
  "author": "Timothy Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taslabs-net/homeflare-kit.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external --sourcemap=linked",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "types": "tsc --noEmit",
    "test": "bun test",
    "smoke": "echo 'auth: no published surface yet — nothing to smoke'"
  },
  "dependencies": {
    "@homeflare/kit": "workspace:*",
    "better-auth": "1.7.5",
    "better-auth-cloudflare": "0.3.1"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@cloudflare/workers-types": "catalog:"
  },
  "peerDependencies": {
    "@better-auth/drizzle-adapter": "^1.5.0",
    "@cloudflare/workers-types": ">=4"
  }
}
