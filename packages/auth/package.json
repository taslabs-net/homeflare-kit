{
  "name": "@homeflare/auth",
  "version": "0.2.0",
  "description": "D1 storage for official Better Auth. Not an auth factory, not the community Cloudflare adapter.",
  "homepage": "https://github.com/taslabs-net/homeflare-kit/tree/main/packages/auth#readme",
  "bugs": "https://github.com/taslabs-net/homeflare-kit/issues",
  "license": "MIT",
  "author": "Timothy Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taslabs-net/homeflare-kit.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external --sourcemap=linked",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "types": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "@better-auth/drizzle-adapter": "^1.5.0",
    "better-auth": "^1.5.0",
    "drizzle-orm": "^0.45.2 || >=1.0.0-rc.1 <2.0.0"
  }
}
