{
  "name": "@homeflare/cloudflare",
  "version": "0.3.1",
  "description": "Cloudflare Workers helpers: Access identity, MCP OAuth metadata, and structured logging.",
  "homepage": "https://github.com/taslabs-net/homeflare-kit/tree/main/packages/cloudflare#readme",
  "bugs": "https://github.com/taslabs-net/homeflare-kit/issues",
  "license": "MIT",
  "author": "Timothy Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taslabs-net/homeflare-kit.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./access-auth": {
      "types": "./dist/access-auth/index.d.ts",
      "default": "./dist/access-auth/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/access-auth/index.ts --root ./src --outdir dist --target node --format esm --packages external --sourcemap=linked",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@homeflare/kit": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:"
  }
}
