{
  // Self-contained on purpose — this package is a straight copy of
  // @distilled.cloud/proxmox-backup from the distilled clone (see README.md), never
  // hand-edited, so it keeps distilled's own compiler baseline rather than
  // the kit's packages/config presets (in particular, NOT
  // isolatedDeclarations: the generated services/*.ts files rely on the
  // `as any as S.Schema<X>` cast pattern distilled's own compiler emits,
  // and re-deriving that to satisfy a different lib preset on every
  // regenerate-and-copy cycle is exactly the friction this interim route
  // exists to avoid). A future vendor package copies this file unchanged.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts"]
}
