{
  // ⛔ EXTENDS tsconfig.base.json, NOT tsconfig.lib.json — a documented exception.
  //
  // 🔴 isolatedDeclarations CANNOT EXPRESS Effect'S SERVICE PATTERN. Measured 2026-09-15:
  //   `class CloudflareApi extends Context.Service<…>()('name') {}` is TS9021, "extends
  //   clause can't contain an expression", and `Provider.ProviderCollection<…>()` is the
  //   same. That is not a style problem in this code — it is how Effect and Alchemy
  //   declare services, and every provider package will hit it.
  //
  // ⚠️ WHAT THIS COSTS. The .d.ts is INFERRED here rather than stated, so it can drift
  //   from the .js if the two passes ever disagree. The other packages keep
  //   isolatedDeclarations precisely because they can.
  // ★ WHAT HOLDS THE LINE INSTEAD: `bun run types` still typechecks everything, and the
  //   build still emits declarations from source rather than by hand.
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "declaration": true
  },
  "include": ["src", "tests"]
}
