    "./linux": {
      "types": "./dist/linux/index.d.ts",
      "default": "./dist/linux/index.js"
    },
    "./paperless": {
      "types": "./dist/paperless/index.d.ts",
      "default": "./dist/paperless/index.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "default": "./dist/release/index.js"
    },
    "./caddy": {
      "types": "./dist/caddy/index.d.ts",
