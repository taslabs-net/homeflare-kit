    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/argocd/index.ts ./src/cloudflare/index.ts ./src/forgejo/index.ts ./src/github/index.ts ./src/openbao/index.ts ./src/talos/index.ts ./src/proxmox/index.ts ./src/ceph/index.ts ./src/netbox/index.ts ./src/postgres/index.ts ./src/launchd/index.ts ./src/linux/index.ts ./src/paperless/index.ts ./src/release/index.ts ./src/caddy/index.ts ./src/litellm/index.ts ./src/google-workspace/index.ts ./src/grafana/index.ts ./src/discord/index.ts ./src/unifi/index.ts ./src/opnsense/index.ts ./src/valkey/index.ts ./src/verify/index.ts ./src/verify/cli.ts ./src/telemetry/index.ts --root ./src --outdir dist --target node --format esm --packages external --sourcemap=linked",
    "build:types": "bun run build:interim-deps && tsc --project tsconfig.build.json",
    "build:interim-deps": "bun --cwd=../distilled-openbao run build && bun --cwd=../distilled-netbox run build && bun --cwd=../distilled-proxmox run build && bun --cwd=../distilled-proxmox-backup run build && bun --cwd=../distilled-paperless-ngx run build && bun --cwd=../distilled-litellm run build && bun --cwd=../distilled-caddy run build && bun --cwd=../distilled-grafana run build && bun --cwd=../distilled-unifi-network run build && bun --cwd=../distilled-opnsense run build",
    "clean": "rm -rf dist",
    "types": "bun run build:interim-deps && tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@distilled.cloud/caddy": "npm:@homeflare/distilled-caddy@0.2.3",
    "@distilled.cloud/grafana": "npm:@homeflare/distilled-grafana@0.2.1",
