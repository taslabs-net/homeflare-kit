{
  "name": "@homeflare/alchemy",
  "version": "0.15.0",
  "description": "Custom Alchemy providers for Cloudflare, Proxmox, OpenBao, Forgejo, Talos, launchd and Caddy, and a verifier that proves adoptions are no-ops.",
  "homepage": "https://github.com/taslabs-net/homeflare-kit/tree/main/packages/alchemy#readme",
  "bugs": "https://github.com/taslabs-net/homeflare-kit/issues",
  "license": "MIT",
  "author": "Timothy Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taslabs-net/homeflare-kit.git",
    "directory": "packages/alchemy"
  },
  "bin": {
    "hf-adopt-verify": "./dist/verify/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./forgejo": {
      "types": "./dist/forgejo/index.d.ts",
      "default": "./dist/forgejo/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github/index.js"
    },
    "./openbao": {
      "types": "./dist/openbao/index.d.ts",
      "default": "./dist/openbao/index.js"
    },
    "./talos": {
      "types": "./dist/talos/index.d.ts",
      "default": "./dist/talos/index.js"
    },
    "./proxmox": {
      "types": "./dist/proxmox/index.d.ts",
      "default": "./dist/proxmox/index.js"
    },
    "./launchd": {
      "types": "./dist/launchd/index.d.ts",
      "default": "./dist/launchd/index.js"
    },
    "./netbox": {
      "types": "./dist/netbox/index.d.ts",
      "default": "./dist/netbox/index.js"
    },
    "./caddy": {
      "types": "./dist/caddy/index.d.ts",
      "default": "./dist/caddy/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "default": "./dist/verify/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/cloudflare/index.ts ./src/forgejo/index.ts ./src/github/index.ts ./src/openbao/index.ts ./src/talos/index.ts ./src/proxmox/index.ts ./src/netbox/index.ts ./src/launchd/index.ts ./src/caddy/index.ts ./src/verify/index.ts ./src/verify/cli.ts --root ./src --outdir dist --target node --format esm --packages external --sourcemap=linked",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "types": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.12",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "alchemy": "2.0.0-beta.79",
    "cloudflare": "4.5.0",
    "effect": "4.0.0-rc.115",
    "handlebars": "catalog:",
    "mime": "4.1.0"
  },
  "peerDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.12",
    "@effect/platform-node": "4.0.0-rc.115",
    "alchemy": "2.0.0-beta.79",
    "cloudflare": ">=4.5.0",
    "effect": "4.0.0-rc.115",
    "mime": "4.1.0"
  }
}
