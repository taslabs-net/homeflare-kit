{
  "name": "@homeflare/alchemy",
  "version": "0.29.0",
  "description": "Custom Alchemy providers for Cloudflare, Proxmox, OpenBao, Forgejo, Talos, launchd and Caddy, and a verifier that proves adoptions are no-ops.",
  "homepage": "https://github.com/taslabs-net/homeflare-kit/tree/main/packages/alchemy#readme",
  "bugs": "https://github.com/taslabs-net/homeflare-kit/issues",
  "license": "MIT",
  "author": "Timothy Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taslabs-net/homeflare-kit.git",
    "directory": "packages/alchemy"
  },
  "bin": {
    "hf-adopt-verify": "./dist/verify/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./forgejo": {
      "types": "./dist/forgejo/index.d.ts",
      "default": "./dist/forgejo/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github/index.js"
    },
    "./openbao": {
      "types": "./dist/openbao/index.d.ts",
      "default": "./dist/openbao/index.js"
    },
    "./talos": {
      "types": "./dist/talos/index.d.ts",
      "default": "./dist/talos/index.js"
    },
    "./proxmox": {
      "types": "./dist/proxmox/index.d.ts",
      "default": "./dist/proxmox/index.js"
    },
    "./launchd": {
      "types": "./dist/launchd/index.d.ts",
      "default": "./dist/launchd/index.js"
    },
    "./netbox": {
      "types": "./dist/netbox/index.d.ts",
      "default": "./dist/netbox/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./linux": {
      "types": "./dist/linux/index.d.ts",
      "default": "./dist/linux/index.js"
    },
    "./paperless": {
      "types": "./dist/paperless/index.d.ts",
      "default": "./dist/paperless/index.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "default": "./dist/release/index.js"
    },
    "./caddy": {
      "types": "./dist/caddy/index.d.ts",
      "default": "./dist/caddy/index.js"
    },
    "./litellm": {
      "types": "./dist/litellm/index.d.ts",
      "default": "./dist/litellm/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "default": "./dist/verify/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/cloudflare/index.ts ./src/forgejo/index.ts ./src/github/index.ts ./src/openbao/index.ts ./src/talos/index.ts ./src/proxmox/index.ts ./src/netbox/index.ts ./src/postgres/index.ts ./src/launchd/index.ts ./src/linux/index.ts ./src/paperless/index.ts ./src/release/index.ts ./src/caddy/index.ts ./src/litellm/index.ts ./src/verify/index.ts ./src/verify/cli.ts --root ./src --outdir dist --target node --format esm --packages external --sourcemap=linked",
    "build:types": "bun run build:interim-deps && tsc --project tsconfig.build.json",
    "build:interim-deps": "bun --cwd=../distilled-netbox run build && bun --cwd=../distilled-proxmox run build && bun --cwd=../distilled-paperless-ngx run build && bun --cwd=../distilled-litellm run build && bun --cwd=../distilled-caddy run build",
    "clean": "rm -rf dist",
    "types": "bun run build:interim-deps && tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@distilled.cloud/caddy": "npm:@homeflare/distilled-caddy@0.2.2",
    "@distilled.cloud/litellm": "npm:@homeflare/distilled-litellm@0.2.0",
    "@distilled.cloud/netbox": "npm:@homeflare/distilled-netbox@0.3.0",
    "@distilled.cloud/paperless-ngx": "npm:@homeflare/distilled-paperless-ngx@0.3.0",
    "@distilled.cloud/proxmox": "npm:@homeflare/distilled-proxmox@0.2.0",
    "@distilled.cloud/proxmox-backup": "npm:@homeflare/distilled-proxmox-backup@0.2.0"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.12",
    "@distilled.cloud/discord": "1.0.0-rc.12",
    "@distilled.cloud/forgejo": "1.0.0-rc.12",
    "@distilled.cloud/google-workspace": "1.0.0-rc.12",
    "@distilled.cloud/grafana": "1.0.0-rc.12",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/sql-pg": "4.0.0-rc.115",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "handlebars": "catalog:",
    "mime": "4.1.0"
  },
  "peerDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.12",
    "@distilled.cloud/discord": "1.0.0-rc.12",
    "@distilled.cloud/forgejo": "1.0.0-rc.12",
    "@distilled.cloud/google-workspace": "1.0.0-rc.12",
    "@distilled.cloud/grafana": "1.0.0-rc.12",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/sql-pg": "4.0.0-rc.115",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "mime": "4.1.0"
  }
}
