{
  // Declaration-only build. `bun build` emits the JS; it cannot emit .d.ts
  // (measured 2026-09-15: no dts flag exists in `bun build --help`), so the
  // types come from the compiler and nothing else does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // ⚠️ The authoring config allows .ts import specifiers; declaration emit must not
    //   copy them into published .d.ts files, where they would not resolve.
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": ["tests", "**/*.test.ts"]
}
