{
  "name": "homeflare-kit",
  "private": true,
  "description": "HomeFlare's shared packages. Bun-native to author, runtime-neutral to consume.",
  "homepage": "https://github.com/taslabs-net/homeflare-kit#readme",
  "bugs": "https://github.com/taslabs-net/homeflare-kit/issues",
  "license": "MIT",
  "author": "Timothy Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taslabs-net/homeflare-kit.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "api:coverage": "bun run scripts/api-coverage.ts",
    "clean": "bun run --filter '*' clean",
    "lint": "oxfmt --check . && oxlint --deny-warnings .",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "types": "tsc --noEmit && bun run --filter '*' types",
    "test": "bun test",
    "check": "bun run lint && bun run types && bun run build && bun test",
    "smoke": "bun run --filter '*' smoke",
    "verify": "bun run check && bun run smoke",
    "changeset": "changeset",
    "version": "changeset version && bun run scripts/sync-versions.ts",
    "release": "bun run build && bun run scripts/publish.ts",
    "summary": "bun run scripts/ci-summary.ts",
    "repo-shape:refresh": "bun run repo-shape.ts",
    "github:apply-ruleset": "bun run scripts/apply-main-ruleset.ts",
    "prepare": "husky",
    "security:scan": "gitleaks dir --redact --no-banner ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@octokit/rest": "catalog:",
    "@types/bun": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "typescript": "7.0.2",
    "oxlint": "1.83.0",
    "oxfmt": "0.68.0",
    "@octokit/rest": "22.0.1",
    "@types/bun": "1.4.2",
    "husky": "9.1.7",
    "@changesets/cli": "3.0.3",
    "@changesets/changelog-github": "1.0.1",
    "alchemy": "2.0.0-beta.79",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "mime": "4.1.0",
    "handlebars": "4.7.9",
    "@flue/cli": "2.0.8",
    "@flue/react": "2.0.8",
    "@flue/runtime": "2.0.8",
    "@flue/vite": "2.0.8",
    "@cloudflare/workers-types": "5.20260908.1",
    "@cloudflare/kumo": "2.13.2",
    "@phosphor-icons/react": "2.1.10",
    "zod": "4.6.5",
    "jose": "6.2.12",
    "hono": "4.13.7",
    "@hono/zod-openapi": "1.6.3",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "@tanstack/react-query": "5.102.8",
    "ky": "2.1.0",
    "capnweb": "0.12.0",
    "better-auth": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@typesafe-ai/sdk": "0.6.0",
    "drizzle-orm": "0.45.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "echarts": "^6.0.0"
  }
}
